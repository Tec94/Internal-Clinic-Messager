{
  "name": "yksg-messaging-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:supabase": "supabase test db --local && node supabase/tests/integration/realtime.mjs && node supabase/tests/integration/attachments.mjs",
    "test:e2e": "playwright test",
    "provision:employees": "node scripts/provision-accounts.mjs --manifest .employee-accounts.local.json",
    "provision:test-accounts": "node scripts/provision-test-accounts.mjs",
    "scanner:build": "docker build -t yksg-attachment-scanner scanner",
    "type-check": "tsc -b --pretty false",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:run:android": "npm run build && cap run android",
    "mobile:run:ios": "npm run build && cap run ios",
    "mobile:assets": "capacitor-assets generate --ios --android --iconBackgroundColor #555889 --iconBackgroundColorDark #555889 --splashBackgroundColor #f4f4f8 --splashBackgroundColorDark #252533"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-context-menu": "2.3.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "2.3.7",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.81.5",
    "i18next": "^25.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "react-i18next": "^15.5.3",
    "react-router-dom": "7.18.4",
    "tus-js-client": "4.3.1",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "supabase": "2.109.1",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.11"
  }
}

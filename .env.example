# Open personal Zalo Chat in a separate Zalo-controlled window. The app does
# not store Zalo credentials, tokens, contacts, or messages.
VITE_ENABLE_ZALO_LAUNCHER=true

# Public Supabase browser configuration. Keep service-role keys server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Keep authentication fail-closed. Only automated preview tests set this false.
VITE_REQUIRE_AUTH=true

# Keep private attachments disabled until the Storage buckets, migration, and
# Edge Functions are deployed and verified in the target environment.
VITE_ENABLE_ATTACHMENTS=false

# Public Web Push application-server key. Keep the matching private key in the
# notification service only.
VITE_VAPID_PUBLIC_KEY=

# Server-only notification Edge Function settings; configure in Supabase.
# Never prefix the worker secret or private VAPID key with VITE_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_WORKER_SECRET=
PUSH_ALLOWED_ORIGINS=
# Owner-delegated policy: 60-second retry; 400-second lease matches Supabase's
# documented maximum paid worker wall lifetime. See docs/DEPLOYMENT.md.
PUSH_DELIVERY_LEASE_SECONDS=400
PUSH_DELIVERY_RETRY_SECONDS=60

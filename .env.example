# Public Zalo Official Account configuration for the browser-only chat widget.
# Create .env.local from this file and replace the placeholder with your OA ID.
VITE_ZALO_OA_ID=
VITE_ZALO_WELCOME_MESSAGE=Welcome to YKSG messages.

# Public Supabase browser configuration. Keep service-role keys server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
